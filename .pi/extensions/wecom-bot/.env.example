# 企业微信机器人配置
WECOM_BOT_ID=your-bot-id
WECOM_BOT_SECRET=your-bot-secret
WECOM_NOTIFY_CHAT_ID=your-notify-chat-id
WECOM_NOTIFY_LABEL=ops-or-owner

# 定时提醒配置 (可选)
WECOM_REMINDER_ENABLED=true
WECOM_REMINDER_TIME=19:30
WECOM_REMINDER_MESSAGE=👋 下班时间到！记得收拾好东西，愉快回家～

# GitHub 今日新上榜 (可选)
WECOM_GITHUB_TODAY_ENABLED=true
WECOM_GITHUB_TODAY_TIME=20:15
# WECOM_GITHUB_TODAY_LANGUAGE=TypeScript

# 60秒读懂世界 (可选) - 每天热点新闻图片推送
WECOM_60S_NEWS_ENABLED=true
WECOM_60S_NEWS_TIME=17:30
